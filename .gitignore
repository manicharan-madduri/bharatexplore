# =============================================================================
# BharatExplore — Root .gitignore
# =============================================================================

# --- 1. Environment Files & Secrets (Keep only safe *.env.example templates) ---
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Local / private Spring Boot profile overrides that may hold credentials
application-local.yml
application-local.yaml
application-local.properties
application-prod.yml
application-prod.yaml
application-prod.properties
application-production.yml
application-production.yaml
application-production.properties
application-secret*.yml
application-secret*.yaml
application-secret*.properties
**/application-local.*
**/application-prod.*
**/application-production.*
**/application-secret*.*

# Private keys, certificates, and keystores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.truststore
*.crt
*.cer
*.der
*.csr

# --- 2. Build Outputs & Dependency Directories ---
backend/target/
**/target/
frontend/node_modules/
**/node_modules/
frontend/dist/
frontend/dist-ssr/
**/dist/
.vite/
**/.vite/
.npm/
.eslintcache
*.jar
*.war
*.nar
*.ear
*.class

# --- 3. Local Backups, Reference Screenshots & Scratch Artifacts ---
__backup_phaseA1/
__backup*/
backups/
**/__backup*/
**/*.bak
**/*.backup
**/*.old
**/*.orig
Design reference/
scratch/

# --- 4. Database Dumps, Private Exports & Logs ---
*.sql
*.sql.gz
*.dump
*.tsv
*.csv
*.sqlite
*.sqlite3
*.db
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
hs_err_pid*
replay_pid*

# --- 5. IDE & Editor Metadata ---
.metadata/
.vscode/
.idea/
**/nbproject/
.settings/
**/.settings/
.classpath
**/.classpath
.project
**/.project
.factorypath
**/.factorypath
.springBeans
**/.springBeans
.sts4-cache/
**/.sts4-cache/
*.iml
*.ipr
*.iws
*.suo
*.ntvs*
*.njsproj
*.sln

# --- 6. OS & Temporary Files ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.swp
*.swo
*~
