# =============================================================================
# BharatExplore Backend — Environment Variable Template (backend/.env.example)
# =============================================================================
# Copy or export these variables into your shell / process manager environment.
# NEVER commit real passwords, JWT signing keys, or production secrets to Git.
#
# Note: Spring Boot reads standard OS environment variables automatically.
# Local development (`SPRING_PROFILES_ACTIVE=dev`, active by default) runs
# out-of-the-box with safe local defaults when MySQL is running on port 3306.
# Production (`SPRING_PROFILES_ACTIVE=prod`) REQUIRES explicit database
# credentials (non-root) and a strong Base64 JWT_SECRET_KEY (>= 256 bits).
# =============================================================================

# --- 1. Active Profile & Server Port ---
# Allowed profiles: dev (default locally) | prod
SPRING_PROFILES_ACTIVE=dev
PORT=8082

# --- 2. MySQL Database Configuration ---
# Local dev default: connects to localhost:3306/tourismdb with useSSL=false.
# Production requirement: MUST set explicit DB_URL (or DB_HOST/DB_NAME with SSL),
# a dedicated non-root DB_USERNAME, and a strong DB_PASSWORD.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tourismdb
DB_USE_SSL=false
DB_REQUIRE_SSL=false
DB_VERIFY_SERVER_CERT=false
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true
DB_CREATE_IF_NOT_EXIST=true

# Optional full JDBC URL override (takes precedence over DB_HOST/DB_PORT/DB_NAME):
# DB_URL=jdbc:mysql://localhost:3306/tourismdb?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# SPRING_DATASOURCE_URL=

# Database credentials (REQUIRED in prod; must NOT be 'root' in prod):
DB_USERNAME=replace_with_db_username
DB_PASSWORD=replace_with_db_password
# SPRING_DATASOURCE_USERNAME=replace_with_db_username
# SPRING_DATASOURCE_PASSWORD=replace_with_db_password

# --- 3. Hibernate Schema Management ---
# Local dev default: update
# Production requirement: validate (or none). NEVER use create or create-drop.
SPRING_JPA_DDL_AUTO=update

# --- 4. JWT & Cookie Security ---
# REQUIRED in prod: Base64-encoded random key of at least 32 bytes (256 bits).
# Generate one safely with: openssl rand -base64 32
JWT_SECRET_KEY=replace_with_base64_encoded_256_bit_secret_key
JWT_EXPIRATION_MS=86400000

# Set JWT_COOKIE_SECURE=true in production (HTTPS); false for local HTTP development
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax

# --- 5. CORS, Frontend URL & Password Reset ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_FRONTEND_URL=http://localhost:5173

# Dev-only console reset link logging (forced to false in prod profile)
PASSWORD_RESET_LOG_LINK_IN_DEV=true
APP_LOG_RESET_LINK_IN_DEV=true

# Swagger / OpenAPI docs (disabled by default in prod profile)
SPRINGDOC_ENABLED=false

# --- 6. Authentication Rate Limiting (Per-Instance In-Memory) ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_TRACKED_KEYS=4096
# Keep false unless running behind a trusted reverse proxy that strips/overwrites X-Forwarded-For
RATE_LIMIT_TRUST_FORWARDED_HEADERS=false
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_FORGOT_PASSWORD_MAX=5
RATE_LIMIT_RESET_PASSWORD_MAX=5
