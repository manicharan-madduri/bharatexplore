# =============================================================================
# BharatExplore Frontend — Environment Variable Template (frontend/.env.example)
# =============================================================================
# Copy this file to `frontend/.env.local` only if you need to override defaults.
#
# SECURITY WARNING:
# Any variable prefixed with `VITE_` is embedded directly into the public
# browser JavaScript bundle at build time (`npm run build`).
# NEVER place secrets, JWT signing keys, database credentials, or private API
# keys in `frontend/.env*` files.
# =============================================================================

# Base URL for backend API requests made by the browser (Axios clients).
# - Default `/api` works automatically in local development (via Vite dev proxy)
#   and in production when served behind a same-origin reverse proxy.
# - Override with a full URL (e.g., https://api.example.com/api) only if the
#   frontend and backend are hosted on separate origins.
VITE_API_BASE_URL=/api

# Target backend server URL used ONLY by the local Vite development server proxy
# (`vite.config.js` -> `/api` proxy during `npm run dev`).
VITE_PROXY_TARGET=http://localhost:8082
